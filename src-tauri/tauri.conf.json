{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fio",
  "version": "0.1.0",
  "identifier": "com.eduardo.fio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "fio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Music",
    "shortDescription": "Virtual audio patchbay for PipeWire/PulseAudio",
    "longDescription": "Fio creates and manages virtual audio devices (sinks with microphone ends) on PipeWire/PulseAudio, routes app and microphone audio into them by rules, and loopbacks their monitor sources to hardware or other devices.",
    "linux": {
      "deb": {
        "depends": ["libpulse0"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
